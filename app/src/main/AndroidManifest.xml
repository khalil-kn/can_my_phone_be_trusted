<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- See every installed app. Since Android 11 apps are hidden from each other without this.
         Google Play restricts it; fine for a sideloaded academic build (see Limitations). -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Alerts for High and Critical incidents (asked at runtime on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the 12-hour check scheduled after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets the "Uninstall…" button open Android's uninstall prompt. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Optional "last opened" times. The user grants it in Android settings. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Deliberately no INTERNET permission: nothing can leave the phone. -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Can_my_phone_be_trusted">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.OnboardingActivity" android:exported="false" />
        <activity android:name=".ui.BaselineActivity" android:exported="false" />
        <activity android:name=".ui.IncidentActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ChangeActivity" android:exported="false" />
        <activity android:name=".ui.AppActivity" android:exported="false" />
        <activity android:name=".ui.ReportNewActivity" android:exported="false" />
        <activity android:name=".ui.NotificationsActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.DeviceActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.HelpActivity" android:exported="false" />
        <activity android:name=".ui.UnlockActivity" android:exported="false" />

        <service
            android:name=".work.CheckJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Shares report files with other apps without exposing the rest of the app's storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
