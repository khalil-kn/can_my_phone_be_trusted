<?xml version="1.0" encoding="utf-8"?>
<!-- One investigation step: tick it off, read why, open the right Android screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/stepDone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:buttonTint="@color/ink" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <TextView
            android:id="@+id/stepTitle"
            style="@style/Body.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/stepWhy"
            style="@style/Small.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/stepAction"
            style="@style/BtnOutline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="44dp" />
    </LinearLayout>
</LinearLayout>
